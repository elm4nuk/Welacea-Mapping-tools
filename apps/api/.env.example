# Salin menjadi apps/api/.env lalu sesuaikan. `python -m app` memuatnya otomatis (berkas .env tidak masuk Git).
# Variabel yang sudah diset di terminal / oleh scripts\run-with-model.ps1 TIDAK ditimpa oleh berkas ini.
# Path Windows ditulis apa adanya (backslash boleh, spasi boleh, tanda kutip opsional).

# --- A. Mode manual (default): biarkan semua baris model dikomentari. ---

# --- B. Simulasi development (SIMULASI — BUKAN AI; jangan untuk keputusan lapangan) ---
# WALLACEA_DETECTOR=simulation

# --- C. Model YOLO tanaman hasil pelatihan (berkas best.pt) ---
# WALLACEA_DETECTOR=ultralytics
# WALLACEA_MODEL_PATH=C:\Users\nama\Model Tanaman\best.pt
# WALLACEA_LABEL_MAP_JSON={"jagung":"plant"}
# WALLACEA_CONFIDENCE=0.35
# WALLACEA_MODEL_PRELOAD=true

# --- Lain-lain ---
# WALLACEA_DATA_DIR=C:\data\wallacea
# WALLACEA_INFERENCE_TIMEOUT_S=120
